---
interface Props {
  /** Initial password, rendered at build time so the page works before the script loads. */
  value: string;
}

const { value } = Astro.props;
---

<div class="password-input-wrapper">
  <div class="password-field" id="password-field">
    <input
      type="text"
      id="password"
      value={value}
      class="password-input"
      placeholder="Enter a password..."
      autocomplete="off"
      spellcheck="false"
      data-1p-ignore
      data-lpignore="true"
      data-form-type="other"
    />
  </div>
  <button type="button" id="generate-password" class="visibility-toggle has-tooltip" aria-label="Generate a random passphrase" data-tooltip="Generate a random passphrase">
    <svg class="dice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="4"></rect>
      <circle cx="8.5" cy="8.5" r="1.25" fill="currentColor" stroke="none"></circle>
      <circle cx="15.5" cy="8.5" r="1.25" fill="currentColor" stroke="none"></circle>
      <circle cx="8.5" cy="15.5" r="1.25" fill="currentColor" stroke="none"></circle>
      <circle cx="15.5" cy="15.5" r="1.25" fill="currentColor" stroke="none"></circle>
    </svg>
  </button>
  <button type="button" id="toggle-visibility" class="visibility-toggle has-tooltip" aria-label="Hide password" data-tooltip="Hide password">
    <svg class="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <svg class="eye-off-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
      <line x1="1" y1="1" x2="23" y2="23"></line>
    </svg>
  </button>
</div>

<style>
  .password-input-wrapper {
    display: flex;
    align-items: center;
    border: 2px solid rgb(var(--accent-border));
    border-radius: 8px;
    background: rgb(var(--bg-surface));
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .password-input-wrapper:focus-within {
    border-color: rgb(var(--accent-blue));
    box-shadow: 0 0 0 4px rgba(var(--accent-blue), 0.1);
  }

  .password-field {
    position: relative;
    flex: 1;
    min-width: 0;  /* let the input shrink rather than stretch the wrapper */
    display: flex;
    overflow: hidden;
    border-radius: 6px 0 0 6px;  /* keep the fades inside the wrapper's rounded corners */
  }

  /* Long passphrases run past the edge of the box: fade the text out on whichever side
     it continues, so it reads as scrollable rather than as if it simply ends there. */
  .password-field::before,
  .password-field::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  /* Eased stops rather than a plain two-stop ramp: a linear alpha fade spends most of
     its width already near-transparent, so the characters look cut off instead of faded.
     No opaque plateau, or the edge characters vanish entirely. */
  .password-field::before {
    left: 0;
    background: linear-gradient(
      to right,
      rgb(var(--bg-surface)),
      rgba(var(--bg-surface), 0.88) 18%,
      rgba(var(--bg-surface), 0.65) 40%,
      rgba(var(--bg-surface), 0.35) 65%,
      rgba(var(--bg-surface), 0.12) 84%,
      rgba(var(--bg-surface), 0)
    );
  }

  .password-field::after {
    right: 0;
    background: linear-gradient(
      to left,
      rgb(var(--bg-surface)),
      rgba(var(--bg-surface), 0.88) 18%,
      rgba(var(--bg-surface), 0.65) 40%,
      rgba(var(--bg-surface), 0.35) 65%,
      rgba(var(--bg-surface), 0.12) 84%,
      rgba(var(--bg-surface), 0)
    );
  }

  .password-field.overflow-left::before,
  .password-field.overflow-right::after {
    opacity: 1;
  }

  .password-input {
    flex: 1;
    min-width: 0;
    font-size: 1.125rem;
    font-weight: 500;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    padding: 0.75rem 0 0.75rem 1rem;
    border: none;
    background: transparent;
    color: rgb(var(--accent-grey));
    outline: none;
  }

  .visibility-toggle {
    padding: 0.75rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgb(var(--accent-grey-light));
    transition: color 0.15s ease;
  }

  .visibility-toggle:hover {
    color: rgb(var(--accent-grey));
  }

  .visibility-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .visibility-toggle .hidden {
    display: none;
  }

  /* Two buttons now share the right edge of the input, so tighten their horizontal padding */
  .password-input-wrapper .visibility-toggle {
    padding-left: 0.375rem;
    padding-right: 0.375rem;
  }

  .password-input-wrapper .visibility-toggle:last-child {
    padding-right: 0.75rem;
  }

  .visibility-toggle:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .has-tooltip {
    position: relative;
  }

  /* Tooltip body and arrow. The body is right-aligned so it never runs off the
     screen on narrow viewports, while the arrow stays centred under the icon. */
  .has-tooltip::after,
  .has-tooltip::before {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
    z-index: 20;
  }

  .has-tooltip::after {
    content: attr(data-tooltip);
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    background: rgb(var(--text-primary));
    color: rgb(var(--bg-surface));
    font-size: 0.75rem;
    line-height: 1.2;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: var(--box-shadow);
  }

  .has-tooltip::before {
    content: '';
    position: absolute;
    top: calc(100% + 0.125rem);
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    transform: translateX(-50%) rotate(45deg);
    background: rgb(var(--text-primary));
    border-radius: 1px;
  }

  /* Hover tooltips have nowhere to go on a touch screen, so only offer them to
     devices that can actually hover; keyboard users get them on focus. */
  @media (hover: hover) {
    .has-tooltip:hover::after,
    .has-tooltip:hover::before {
      opacity: 1;
      visibility: visible;
      transition-delay: 0.25s;
    }
  }

  .has-tooltip:focus-visible::after,
  .has-tooltip:focus-visible::before {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .has-tooltip::after,
    .has-tooltip::before {
      transition: none;
    }
  }

  .dice-icon.rolling {
    animation: dice-roll 0.4s ease;
  }

  @keyframes dice-roll {
    from { transform: rotate(-90deg) scale(0.85); }
    to { transform: rotate(0deg) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dice-icon.rolling {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .password-input {
      font-size: 1rem;
    }
  }
</style>
